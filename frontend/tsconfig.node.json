{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp/tsconfig-node"
  },
  "include": ["vite.config.ts", "playwright.config.ts", "e2e", "scripts"]
}
