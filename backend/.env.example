# PerAI View backend configuration. Every variable is optional; defaults are shown.
# Copy to `.env` for local development. There are no secrets: all data is simulated.

# development | production | test
NODE_ENV=development
# Bind address. Loopback by default so a dev server is not reachable from the LAN.
# Use 0.0.0.0 to listen on all interfaces (the Docker image already does).
HOST=127.0.0.1
PORT=4000

# Comma-separated browser origins allowed by CORS and by the WebSocket upgrade check.
# Must be bare origins (scheme://host[:port]) — add your deployed frontend here.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Number of reverse-proxy hops to trust for the client IP (HTTP rate limits and the
# per-IP WebSocket cap). Leave 0 unless the API runs behind a proxy/load balancer (then usually 1).
TRUST_PROXY=0

# Base URL of the Python classifier (ai-classifier).
#   unset -> http://127.0.0.1:8000 outside production; keyword fallback only in production
#   off   -> never call the model, always use the built-in keyword fallback
AI_CLASSIFIER_URL=http://127.0.0.1:8000

# Requests per IP per 15 minutes (all routes except /api/health).
RATE_LIMIT_MAX=300
# Requests per IP per minute to POST /api/classify.
CLASSIFY_RATE_LIMIT_MAX=30
# Maximum simultaneous WebSocket clients, in total and from a single IP.
WS_MAX_CLIENTS=500
WS_MAX_CLIENTS_PER_IP=10

# Include stack traces in 500 responses. Only honoured when NODE_ENV=development.
EXPOSE_ERROR_DETAILS=false
