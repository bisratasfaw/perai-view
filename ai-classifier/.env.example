# PerAI View - activity classifier
# The service reads these from the process environment (it does not load .env files itself;
# export them in your shell or pass them via docker compose `env_file`).

# Port used by `python -m app.main`. The Docker image always listens on 8000.
PORT=8000
# Bind address for `python -m app.main` (use 0.0.0.0 only inside a container).
HOST=127.0.0.1

# Comma-separated browser origins allowed by CORS (no credentials, GET/POST only).
CORS_ORIGINS=http://localhost:4000,http://localhost:5173

# CRITICAL, ERROR, WARNING, INFO or DEBUG
LOG_LEVEL=INFO
